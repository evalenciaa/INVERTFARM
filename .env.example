# ===== CONFIGURACIÓN DE LA BASE DE DATOS =====
# MySQL/MariaDB
DB_NAME=INVENTFARM
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=3306

# ===== CONFIGURACIÓN DE DJANGO =====
# Genera una clave secreta con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-generada-aqui

# Modo Debug (True para desarrollo, False para producción)
DEBUG=True

# Hosts permitidos (separados por comas sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== CONFIGURACIÓN DE EMAIL (OPCIONAL) =====
# Para notificaciones de alertas CPM
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
